{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calfus.com/schemas/pr-notifier/repos.json",
  "title": "PR notifier repository configuration",
  "description": "Maps owner/repository to the reviewers mentioned in the Teams message.",
  "type": "object",
  "minProperties": 1,
  "propertyNames": { "pattern": "^[\\w.-]+/[\\w.-]+$" },
  "additionalProperties": {
    "type": "object",
    "required": ["reviewers"],
    "properties": {
      "reviewers": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["github", "teams_email"],
          "properties": {
            "github": { "type": "string", "minLength": 1 },
            "teams_email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" }
          }
        }
      }
    }
  }
}
